     Port of the com.oplus.pantanal.ums entries from stock OOS 16.0.8
     my_stock/etc/permissions/com.oplus.pantanal.ums.privapp_permissions.xml
     and my_stock/etc/permissions/privapp-permissions-oplus-products.xml.
     UMS installs to system_ext on this build; same partition as the app
     per the allowlist partition rule.
-->
<permissions>
    <privapp-permissions package="com.oplus.pantanal.ums">
        <permission name="android.permission.BIND_APPWIDGET"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>
</permissions>
